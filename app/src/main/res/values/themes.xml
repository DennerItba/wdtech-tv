<resources>
    <style name="Theme.MyTvApp" parent="Theme.AppCompat.NoActionBar">
        <item name="android:colorPrimary">@color/brand_red</item>
        <item name="android:colorPrimaryDark">#000000</item>
        <item name="android:windowBackground">@drawable/tv_bg</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.MyTvApp.Player" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:keepScreenOn">true</item>
    </style>

    <style name="Theme.MyTvApp.Dialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
    </style>
</resources>
