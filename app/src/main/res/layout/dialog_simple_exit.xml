<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="440dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_wd_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="30dp"
    android:paddingEnd="32dp"
    android:paddingBottom="30dp">

    <!-- Mensagem de Confirmação Fiel ao Protótipo HTML -->
    <TextView
        android:id="@+id/txt_dialog_exit_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Deseja retornar à tela inicial ou sair do aplicativo?"
        android:textColor="@color/wd_text_white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Botões de Ação com Foco D-Pad -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Botão NÃO / Voltar -->
        <Button
            android:id="@+id/btn_dialog_exit_nao"
            android:layout_width="140dp"
            android:layout_height="44dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_wd_action_btn"
            android:clickable="true"
            android:focusable="true"
            android:text="Voltar"
            android:textColor="@color/wd_text_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Botão SIM / Sair -->
        <Button
            android:id="@+id/btn_dialog_exit_sim"
            android:layout_width="140dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_wd_pill"
            android:clickable="true"
            android:focusable="true"
            android:text="Sair"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
