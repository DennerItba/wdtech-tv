<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="480dp"
    android:layout_height="520dp"
    android:background="@drawable/bg_dialog_solid"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top Bar: Title & Subtitle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/outline_live_tv_24"
            android:contentDescription="Ícone de Categoria" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CATEGORIAS DE CANAIS"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selecione para navegar por categoria"
                android:textColor="#A0B4D0"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_dialog_close_cats"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_rail_button"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:focusable="true"
            android:clickable="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#20FFFFFF"
        android:layout_marginBottom="10dp" />

    <!-- RecyclerView de Categorias -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_dialog_categories"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        android:focusable="true" />

</LinearLayout>
