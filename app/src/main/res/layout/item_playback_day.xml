<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/bg_button_selector"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <!-- Nome ou Número do Dia (ex: Hoje ou 30) -->
    <TextView
        android:id="@+id/txt_day_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hoje"
        android:textColor="@color/text_high"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Seta indicadora de dia selecionado (igual à foto do usuário) -->
    <TextView
        android:id="@+id/txt_day_indicator"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:text="▶"
        android:textColor="@color/neon_cyan"
        android:textSize="10sp"
        android:visibility="invisible" />

    <!-- Dia da Semana (ex: QUI, SEX) -->
    <TextView
        android:id="@+id/txt_day_weekday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="QUI"
        android:textColor="@color/neon_cyan"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
