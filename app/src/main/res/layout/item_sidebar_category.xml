<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="42dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/bg_sidebar_item_selector"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="10dp">

    <!-- Indicador Vertical Ciano Ativo (Fiel à foto do usuário) -->
    <View
        android:id="@+id/view_indicator"
        android:layout_width="3dp"
        android:layout_height="20dp"
        android:layout_marginEnd="6dp"
        android:background="#00E5FF"
        android:visibility="invisible" />

    <!-- Ícone da Categoria -->
    <ImageView
        android:id="@+id/img_category_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/outline_live_tv_24"
        android:contentDescription="Ícone" />

    <!-- Nome da Categoria -->
    <TextView
        android:id="@+id/txt_category_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Início"
        android:textColor="@color/text_high"
        android:textSize="13sp"
        android:textStyle="normal" />

    <!-- Contador de Canais da Categoria (Sutil) -->
    <TextView
        android:id="@+id/txt_category_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:background="@drawable/badge_hd"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:text=""
        android:visibility="gone"
        android:textColor="@color/neon_cyan"
        android:textSize="9sp"
        android:textStyle="bold" />

</LinearLayout>
