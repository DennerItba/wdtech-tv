<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="46dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:background="@drawable/bg_wd_category_item"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="12dp">

    <!-- Indicador Vertical Discreto -->
    <View
        android:id="@+id/view_indicator"
        android:layout_width="3dp"
        android:layout_height="18dp"
        android:layout_marginEnd="6dp"
        android:background="@color/wd_brand_blue"
        android:visibility="gone" />

    <!-- Ícone da Categoria -->
    <ImageView
        android:id="@+id/img_category_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/outline_live_tv_24"
        android:contentDescription="Ícone" />

    <!-- Nome da Categoria (Ex: Favoritos, Jogos do dia, Canais 4K) -->
    <TextView
        android:id="@+id/txt_category_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Jogos do dia"
        android:textColor="@color/wd_text_category"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Contador de Títulos / Canais (Ex: 95) -->
    <TextView
        android:id="@+id/txt_category_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_wd_channel_tag"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="95"
        android:visibility="visible"
        android:textColor="@color/wd_text_white"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
