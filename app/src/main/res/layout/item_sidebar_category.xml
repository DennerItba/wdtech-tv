<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/bg_sidebar_item_selector"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="10dp">

    <!-- Ícone da Categoria -->
    <ImageView
        android:id="@+id/img_category_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/outline_live_tv_24"
        android:contentDescription="Ícone" />

    <!-- Nome da Categoria -->
    <TextView
        android:id="@+id/txt_category_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="ESPORTES"
        android:textColor="@color/text_high"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Contador de Canais da Categoria -->
    <TextView
        android:id="@+id/txt_category_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/badge_hd"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:text="12"
        android:textColor="@color/neon_cyan"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
