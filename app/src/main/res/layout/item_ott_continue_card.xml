<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="290dp"
    android:layout_height="164dp"
    android:layout_marginEnd="16dp"
    android:clickable="true"
    android:focusable="true"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- Imagem de Fundo / Miniatura -->
    <ImageView
        android:id="@+id/img_continue_thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/tv_bg"
        android:contentDescription="Miniatura" />

    <!-- Camada de Gradiente Escuro -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_poster_scrim" />

    <!-- Conteúdo Inferior: Título e Barra de Progresso -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/txt_continue_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filmes • 65% assistido"
            android:textColor="@color/neon_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_continue_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="Oppenheimer"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Barra de Progresso Arredondada -->
        <ProgressBar
            android:id="@+id/pb_continue_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="65"
            android:progressDrawable="@drawable/progress_bar_continue" />
    </LinearLayout>

    <!-- Borda e Destaque de Foco D-Pad -->
    <View
        android:id="@+id/view_continue_focus_ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_card_tv_focus" />

</FrameLayout>
