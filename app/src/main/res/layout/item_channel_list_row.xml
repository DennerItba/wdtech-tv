<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/bg_channel_item_selector"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <!-- Mini Logo do Canal -->
    <ImageView
        android:id="@+id/img_row_logo"
        android:layout_width="34dp"
        android:layout_height="26dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:contentDescription="Logo" />

    <!-- Número do Canal (3 dígitos formatados 001, 002...) -->
    <TextView
        android:id="@+id/txt_row_number"
        android:layout_width="38dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="center_vertical"
        android:text="001"
        android:textColor="@color/neon_cyan"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Bloco de Textos: Nome do Canal + EPG Atual -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Nome do Canal -->
        <TextView
            android:id="@+id/txt_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Nome do Canal"
            android:textColor="@color/text_high"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- EPG: Programa Atual no Ar -->
        <TextView
            android:id="@+id/txt_row_epg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="No Ar: Carregando programação..."
            android:textColor="#8EA2C6"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Tag HD / FHD / 4K -->
    <TextView
        android:id="@+id/txt_row_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/badge_hd"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="HD"
        android:textColor="#9AB2D6"
        android:textSize="9sp"
        android:textStyle="bold" />

    <!-- Selo de Playback / 7 Dias Gravados -->
    <TextView
        android:id="@+id/txt_row_playback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:background="@drawable/badge_playback"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="⟲ 7D"
        android:textColor="@color/neon_cyan"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
