<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="450dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_selector"
    android:backgroundTint="#F20B101D"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Mensagem Direta solicitada pelo Usuário -->
    <TextView
        android:id="@+id/txt_update_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Existe uma nova atualização"
        android:textColor="@color/text_white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Botões de Ação para Controle Remoto: SIM e NÃO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_update_confirm"
            android:layout_width="140dp"
            android:layout_height="46dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_button_selector"
            android:focusable="true"
            android:text="SIM"
            android:textAllCaps="true"
            android:textColor="@color/btn_text_selector"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_update_dismiss"
            android:layout_width="140dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_button_selector"
            android:focusable="true"
            android:text="NÃO"
            android:textAllCaps="true"
            android:textColor="@color/btn_text_selector"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
