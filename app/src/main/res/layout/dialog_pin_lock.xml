<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="400dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_player_frame"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <!-- Ícone de Cadeado -->
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/outline_live_tv_24"
        android:tint="@color/neon_cyan"
        android:contentDescription="Bloqueado" />

    <!-- Título -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="CONTROLE PARENTAL (+18)"
        android:textColor="@color/text_high"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Subtítulo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Digite o PIN de 4 dígitos para liberar o acesso"
        android:textColor="@color/text_mid"
        android:textSize="12sp" />

    <!-- Indicador de Dígitos Digitados (4 Pílulas/Círculos) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pin_dot_1"
            android:layout_width="38dp"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_tab_pill"
            android:gravity="center"
            android:text="—"
            android:textColor="@color/neon_cyan"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pin_dot_2"
            android:layout_width="38dp"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_tab_pill"
            android:gravity="center"
            android:text="—"
            android:textColor="@color/neon_cyan"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pin_dot_3"
            android:layout_width="38dp"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_tab_pill"
            android:gravity="center"
            android:text="—"
            android:textColor="@color/neon_cyan"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pin_dot_4"
            android:layout_width="38dp"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_tab_pill"
            android:gravity="center"
            android:text="—"
            android:textColor="@color/neon_cyan"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Mensagem de Erro -->
    <TextView
        android:id="@+id/txt_pin_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="PIN incorreto! Tente novamente."
        android:textColor="@color/neon_red"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="invisible" />

    <!-- Teclado Numérico para Controle Remoto (3 Colunas x 4 Linhas) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Linha 1: 1, 2, 3 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_num_1"
                android:layout_width="60dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/bg_button_selector"
                android:focusable="true"
                android:text="1"
                android:textColor="@color/text_high"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_num_2"
                android:layout_width="60dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/bg_button_selector"
                android:focusable="true"
                android:text="2"
                android:textColor="@color/text_high"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_num_3"
                android:layout_width="60dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/bg_button_selector"
                android:focusable="true"
                android:text="3"
                android:textColor="@color/text_high"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Linha 2: 4, 5, 6 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_num_4"
                android:layout_width="60dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/bg_button_selector"
                android:focusable="true"
                android:text="4"
                android:textColor="@color/text_high"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_num_5"
                android:layout_width="60dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/bg_button_selector"
                android:focusable="true"
                android:text="5"
                android:textColor="@color/text_high"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_num_6"
                android:layout_width="60dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/bg_button_selector"
                android:focusable="true"
                android:text="6"
                android:textColor="@color/text_high"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Linha 3: 7, 8, 9 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_num_7"
                android:layout_width="60dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/bg_button_selector"
                android:focusable="true"
                android:text="7"
                android:textColor="@color/text_high"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_num_8"
                android:layout_width="60dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/bg_button_selector"
                android:focusable="true"
                android:text="8"
                android:textColor="@color/text_high"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_num_9"
                android:layout_width="60dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/bg_button_selector"
                android:focusable="true"
                android:text="9"
                android:textColor="@color/text_high"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Linha 4: Limpar, 0, Cancelar -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_num_clear"
                android:layout_width="60dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/bg_button_selector"
                android:focusable="true"
                android:text="⌫"
                android:textColor="@color/text_mid"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_num_0"
                android:layout_width="60dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/bg_button_selector"
                android:focusable="true"
                android:text="0"
                android:textColor="@color/text_high"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_pin_cancel"
                android:layout_width="60dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/bg_button_selector"
                android:focusable="true"
                android:text="Sair"
                android:textColor="@color/text_mid"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Dica de PIN Padrão -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="PIN padrão inicial: 0000"
        android:textColor="@color/text_low"
        android:textSize="11sp" />

</LinearLayout>
