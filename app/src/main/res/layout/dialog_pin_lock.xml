<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="480dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_wd_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="28dp"
    android:paddingEnd="32dp"
    android:paddingBottom="28dp">

    <!-- Ícone e Título -->
    <TextView
        android:id="@+id/txt_pin_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒 CONTROLE PARENTAL (+18)"
        android:textColor="#00E5FF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_pin_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Conteúdo adulto protegido por segurança.\nDigite o PIN de 4 dígitos (PIN padrão: 0000):"
        android:textColor="#E6EDF8"
        android:textSize="14sp" />

    <!-- Campo de PIN com Máscara e Foco -->
    <TextView
        android:id="@+id/txt_pin_display"
        android:layout_width="220dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_wd_action_btn"
        android:gravity="center"
        android:letterSpacing="0.4"
        android:text="••••"
        android:textColor="#00E5FF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_pin_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="PIN incorreto! Tente novamente."
        android:textColor="#FF5252"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Botões de Ação para o Controle Remoto -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_pin_padrao"
            android:layout_width="140dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_wd_action_btn"
            android:text="PIN: 0000"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_pin_cancel"
            android:layout_width="120dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_wd_action_btn"
            android:text="Voltar"
            android:textColor="#E6EDF8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_pin_unlock"
            android:layout_width="130dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_wd_pill"
            android:text="Confirmar"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
