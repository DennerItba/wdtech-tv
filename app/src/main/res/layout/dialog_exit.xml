<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="460dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_wd_dialog"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sair do aplicativo?"
        android:textColor="@color/wd_text_white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Deseja retornar à tela inicial ou fechar o aplicativo?"
        android:textColor="@color/wd_text_muted"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel_exit"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_wd_action_btn"
            android:focusable="true"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="Cancelar"
            android:textColor="@color/wd_text_white"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_confirm_exit"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_wd_pill"
            android:focusable="true"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Confirmar"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
