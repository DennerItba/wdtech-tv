<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tv_bg">

    <!-- Camada de Gradiente Escuro Cyberpunk/Futurista -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0070B14" />

    <!-- 1. Barra Superior do Playback -->
    <RelativeLayout
        android:id="@+id/playback_top_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:gravity="center_vertical">

        <!-- Logo e Badge Playback -->
        <LinearLayout
            android:id="@+id/playback_logo_layout"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/logo"
                android:adjustViewBounds="true"
                android:contentDescription="Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="WDTECH"
                android:textColor="@color/text_high"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="TV"
                android:textColor="@color/neon_cyan"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="@drawable/badge_playback"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="⟲ GUIA PLAYBACK 7 DIAS"
                android:textColor="@color/neon_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Indicador de Status Central -->
        <TextView
            android:id="@+id/txt_playback_breadcrumb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="24dp"
            android:layout_toEndOf="@id/playback_logo_layout"
            android:text="Selecione um canal e dia para assistir do início"
            android:textColor="@color/text_mid"
            android:textSize="12sp" />

        <!-- Relógio e Botão Voltar à Direita -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:format24Hour="HH:mm"
                android:format12Hour="hh:mm a"
                android:textColor="@color/text_high"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_playback_close"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_button_selector"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="✕ Fechar"
                android:textColor="@color/text_high"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 2. Corpo do Playback em 3 Colunas (Canais + 7 Dias + Programação) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/playback_top_bar"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <!-- COLUNA 1: CANAIS COM PLAYBACK (Esquerda) -->
        <LinearLayout
            android:id="@+id/layout_playback_col_channels"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="6dp"
                android:paddingStart="8dp">

                <TextView
                    android:id="@+id/txt_playback_category_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CANAIS ABERTOS"
                    android:textColor="@color/neon_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_playback_channel_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_hd"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:text="21/74"
                    android:textColor="@color/neon_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_playback_channels"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="false"
                android:nextFocusRight="@id/rv_playback_days"
                android:scrollbars="none" />
        </LinearLayout>

        <!-- COLUNA 2: DIAS (7 DIAS DA SEMANA) (Centro) -->
        <LinearLayout
            android:id="@+id/layout_playback_col_days"
            android:layout_width="115dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/txt_playback_month"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="2dp"
                android:paddingBottom="6dp"
                android:text="OUT"
                android:textColor="@color/neon_cyan"
                android:textSize="13sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_playback_days"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="false"
                android:nextFocusLeft="@id/rv_playback_channels"
                android:nextFocusRight="@id/rv_playback_programs"
                android:scrollbars="none" />
        </LinearLayout>

        <!-- COLUNA 3: PROGRAMAÇÃO DO DIA E DETALHES (Direita) -->
        <LinearLayout
            android:id="@+id/layout_playback_col_programs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <!-- Card Superior de Detalhes do Programa em Foco -->
            <RelativeLayout
                android:id="@+id/card_playback_program_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dialog_playback"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/img_playback_detail_logo"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_detail_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🕒 Duração: 20:30 - 21:30"
                        android:textColor="@color/text_high"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_detail_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="📺 Programa: Jornal Nacional"
                        android:textColor="@color/neon_cyan"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_detail_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:maxLines="3"
                        android:text="Descrição: As principais notícias do Brasil e do mundo com reportagens completas e coberturas especiais."
                        android:textColor="@color/text_mid"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/img_playback_detail_logo"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/logo"
                    android:adjustViewBounds="true"
                    android:contentDescription="Logo Canal" />
            </RelativeLayout>

            <!-- Divisor -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"
                android:background="#1F2E45" />

            <!-- Lista Vertical de Programas -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_playback_programs"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="false"
                android:nextFocusLeft="@id/rv_playback_days"
                android:scrollbars="none" />

            <!-- Rodapé com Instruções de Controle Remoto -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="4dp"
                android:text="&#9668; / &#9658; Navegar Colunas  •  &#9650; / &#9660; Rolar  •  OK: Assistir Gravação  •  Voltar: Fechar"
                android:textColor="@color/text_low"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
