<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="480dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_playback"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Título Principal (Fiel à foto do usuário) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Configurações de reprodução"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="#1E2F4D" />

    <!-- 1. Áudio -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Áudio"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_audio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_audio_pt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:focusable="true"
            android:text="Português"
            android:textColor="#E6EDF8"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rb_audio_en"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:focusable="true"
            android:text="Inglês"
            android:textColor="#E6EDF8"
            android:textSize="13sp" />
    </RadioGroup>

    <!-- 2. Idioma da Legenda -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Idioma da legenda"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_subtitles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_sub_off"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:text="Desligar legendas"
            android:textColor="#E6EDF8"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rb_sub_pt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:checked="true"
            android:focusable="true"
            android:text="Português"
            android:textColor="#E6EDF8"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rb_sub_en"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:focusable="true"
            android:text="Inglês"
            android:textColor="#E6EDF8"
            android:textSize="13sp" />
    </RadioGroup>

    <!-- 3. Tempo de Legendas (Offset / Delay) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tempo de legendas"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_sub_delay_minus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_button_selector"
            android:focusable="true"
            android:text="-"
            android:textColor="#00E5FF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_sub_delay_value"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="0.0 s"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_sub_delay_plus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_button_selector"
            android:focusable="true"
            android:text="+"
            android:textColor="#00E5FF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/badge_playback"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="Hora das legendas"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4. Tamanho da Legenda -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Tamanho da legenda"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_sub_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_size_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:focusable="true"
            android:text="Normal"
            android:textColor="#E6EDF8"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rb_size_large"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:focusable="true"
            android:text="Grande"
            android:textColor="#E6EDF8"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rb_size_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:focusable="true"
            android:text="Pequeno"
            android:textColor="#E6EDF8"
            android:textSize="13sp" />
    </RadioGroup>

    <!-- 5. Estilo da Legenda -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Estilo da legenda"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_sub_style"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_style_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:focusable="true"
            android:text="Aa (Branca)"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/rb_style_yellow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:focusable="true"
            android:text="Aa (Amarela)"
            android:textColor="#FFEB3B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/rb_style_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:focusable="true"
            android:text="Aa (Fundo Preto)"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </RadioGroup>

    <!-- Botão Saída (Fiel à foto do usuário) -->
    <Button
        android:id="@+id/btn_settings_exit"
        android:layout_width="200dp"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_action_reproduzindo"
        android:focusable="true"
        android:text="Saída"
        android:textColor="#04172E"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Pressione Voltar ou Saída para retornar à reprodução"
        android:textColor="#8EA9C7"
        android:textSize="10sp" />
</LinearLayout>
