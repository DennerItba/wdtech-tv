<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tv_bg">

    <!-- Camada de Gradiente Escuro Cinematográfico Fundo -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A0080D16" />

    <!-- ================================================================= -->
    <!-- TELA 1: HOME HUB (TELA INICIAL - FIEL À IMAGEM 2)                -->
    <!-- ================================================================= -->
    <RelativeLayout
        android:id="@+id/layout_home_hub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <!-- Topo: Relógio e WiFi à Direita -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_wifi_tv"
                android:contentDescription="WiFi" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format24Hour="HH:mm"
                android:format12Hour="hh:mm a"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Centro do Hub: Logo + 4 Círculos Grandes + Botão Recarregar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Logo e Emblema WDTECH TV Central -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/img_home_logo"
                    android:layout_width="85dp"
                    android:layout_height="85dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo"
                    android:contentDescription="WDTECH TV Logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:letterSpacing="0.1"
                    android:shadowColor="#FFB300"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="12"
                    android:text="WDTECH TV"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 4 Grandes Botões Circulares Estilo Vivaon (Imagem 2) -->
            <LinearLayout
                android:id="@+id/layout_hub_circles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- 1. HUB: TV AO VIVO -->
                <LinearLayout
                    android:id="@+id/hub_tv"
                    android:layout_width="135dp"
                    android:layout_height="135dp"
                    android:layout_margin="14dp"
                    android:background="@drawable/bg_hub_circle"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:nextFocusRight="@+id/hub_filmes"
                    android:nextFocusDown="@+id/btn_home_reload">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:tint="#FFFFFF"
                        android:src="@drawable/outline_live_tv_24"
                        android:contentDescription="TV AO VIVO" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="TV AO VIVO"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 2. HUB: FILMES -->
                <LinearLayout
                    android:id="@+id/hub_filmes"
                    android:layout_width="135dp"
                    android:layout_height="135dp"
                    android:layout_margin="14dp"
                    android:background="@drawable/bg_hub_circle"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:nextFocusLeft="@+id/hub_tv"
                    android:nextFocusRight="@+id/hub_series"
                    android:nextFocusDown="@+id/btn_home_reload">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:tint="#FFFFFF"
                        android:src="@drawable/ic_movie_vod"
                        android:contentDescription="FILMES" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="FILMES"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 3. HUB: SÉRIES -->
                <LinearLayout
                    android:id="@+id/hub_series"
                    android:layout_width="135dp"
                    android:layout_height="135dp"
                    android:layout_margin="14dp"
                    android:background="@drawable/bg_hub_circle"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:nextFocusLeft="@+id/hub_filmes"
                    android:nextFocusRight="@+id/hub_ajustes"
                    android:nextFocusDown="@+id/btn_home_reload">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:tint="#FFFFFF"
                        android:src="@drawable/ic_series_vod"
                        android:contentDescription="SÉRIES" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="SÉRIES"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 4. HUB: AJUSTES -->
                <LinearLayout
                    android:id="@+id/hub_ajustes"
                    android:layout_width="135dp"
                    android:layout_height="135dp"
                    android:layout_margin="14dp"
                    android:background="@drawable/bg_hub_circle"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:nextFocusLeft="@+id/hub_series"
                    android:nextFocusDown="@+id/btn_home_reload">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:tint="#FFFFFF"
                        android:src="@drawable/ic_settings"
                        android:contentDescription="AJUSTES" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="AJUSTES"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- Botão Recarregar o Aplicativo (Pill) -->
            <Button
                android:id="@+id/btn_home_reload"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_vivaon_pill"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="🔄  Recarregar o aplicativo"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:nextFocusUp="@+id/hub_tv" />

            <!-- Indicador Inferior -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▼"
                    android:textColor="#70FFFFFF"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Próximos jogos &amp; Últimos adicionados"
                    android:textColor="#8EA4C4"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- Rodapé do Hub: Chave do Dispositivo à Esquerda, Versão à Direita -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_alignParentBottom="true"
            android:background="#A0060A12"
            android:paddingStart="28dp"
            android:paddingEnd="28dp">

            <TextView
                android:id="@+id/txt_device_key"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Chave do dispositivo: WD-9A88"
                android:textColor="#C0D4EC"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_home_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="WDTECH TV v2.9.9"
                android:textColor="#7A92B4"
                android:textSize="12sp" />
        </RelativeLayout>

    </RelativeLayout>

    <!-- ================================================================= -->
    <!-- TELA 2 & 3: CONTAINER DE CONTEÚDO (TV, VOD E AJUSTES)              -->
    <!-- ================================================================= -->
    <RelativeLayout
        android:id="@+id/layout_main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Barra Superior Compacta com Botão Voltar para o Hub e Breadcrumb -->
        <RelativeLayout
            android:id="@+id/top_navigation_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingStart="20dp"
            android:paddingEnd="24dp"
            android:gravity="center_vertical">

            <!-- Botão Home / Voltar -->
            <Button
                android:id="@+id/btn_toggle_menu"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_vivaon_pill"
                android:text="🏠 INÍCIO"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:focusable="true"
                android:clickable="true"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

            <!-- Breadcrumb da Seção -->
            <TextView
                android:id="@+id/txt_header_breadcrumb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="14dp"
                android:layout_toEndOf="@id/btn_toggle_menu"
                android:text="WDTECH TV • TV AO VIVO"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Relógio à Direita -->
            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:format24Hour="HH:mm"
                android:format12Hour="hh:mm a"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- ============================================================= -->
        <!-- MODO 1: TV AO VIVO (FIEL À IMAGEM 3)                         -->
        <!-- ============================================================= -->
        <LinearLayout
            android:id="@+id/layout_tv_mode"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/top_navigation_bar"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp"
            android:visibility="visible">

            <!-- Trilho Vertical de Acesso Rápido à Esquerda (Ícones) -->
            <LinearLayout
                android:id="@+id/layout_quick_rail"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:gravity="top|center_horizontal"
                android:orientation="vertical"
                android:paddingTop="12dp">

                <!-- 1. Busca -->
                <ImageView
                    android:id="@+id/btn_rail_search"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_rail_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="9dp"
                    android:src="@drawable/ic_search_tv"
                    android:contentDescription="Buscar"
                    android:nextFocusRight="@+id/rv_channel_list" />

                <!-- 2. Favoritos -->
                <ImageView
                    android:id="@+id/btn_rail_favorites"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_rail_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="9dp"
                    android:src="@drawable/ic_heart_fav"
                    android:contentDescription="Favoritos"
                    android:nextFocusRight="@+id/rv_channel_list" />

                <!-- 3. Recentes -->
                <ImageView
                    android:id="@+id/btn_rail_recents"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_rail_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="9dp"
                    android:src="@drawable/ic_playback"
                    android:contentDescription="Recentes"
                    android:nextFocusRight="@+id/rv_channel_list" />

                <!-- 4. Categorias -->
                <ImageView
                    android:id="@+id/btn_rail_categories"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_rail_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="9dp"
                    android:src="@drawable/outline_live_tv_24"
                    android:contentDescription="Categorias"
                    android:nextFocusRight="@+id/rv_channel_list" />
            </LinearLayout>

            <!-- Coluna Central: Lista de Canais (com Header de Categoria) -->
            <LinearLayout
                android:layout_width="330dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <!-- Header de Categoria (Ex: 🏷 Favoritos / Futebol) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/txt_tv_category_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🏷 Favoritos"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_category_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_netflix_badge"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="24"
                        android:textColor="#00E5FF"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- RecyclerView de Canais -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_channel_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:nextFocusLeft="@+id/btn_rail_favorites"
                    android:nextFocusRight="@+id/player_preview_container"
                    android:scrollbars="none" />
            </LinearLayout>

            <!-- Coluna Direita: Preview Player + 3 Linhas de EPG (Imagem 3) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Topo: Player Preview com Barra Superior de Dica -->
                <RelativeLayout
                    android:id="@+id/player_preview_container"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_player_frame"
                    android:clickable="true"
                    android:focusable="true">

                    <!-- Surface do Player Preview -->
                    <androidx.media3.ui.PlayerView
                        android:id="@+id/player_preview_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:use_controller="false"
                        app:resize_mode="fit"
                        app:surface_type="texture_view" />

                    <!-- Faixa Superior de Dica: "Para o menu de ação, pressione longamente o botão OK" -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:background="#B00A101C"
                        android:gravity="center"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Para o menu de ação, pressione longamente o botão OK"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Spinner de Conexão -->
                    <LinearLayout
                        android:id="@+id/preview_loading_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <ProgressBar
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:indeterminateTint="#00E5FF" />

                        <TextView
                            android:id="@+id/txt_bitrate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="CONECTANDO SINAL..."
                            android:textColor="#00E5FF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </RelativeLayout>

                <!-- Base: Programação EPG em 3 Linhas (Fiel à Imagem 3) -->
                <LinearLayout
                    android:id="@+id/layout_epg_schedule_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <!-- Linha 1: Programa Atual (Ponto Verde) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/bg_epg_row"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:src="@drawable/ic_dot_green"
                            android:contentDescription="Status" />

                        <TextView
                            android:id="@+id/txt_epg_now_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Transmissão Ao Vivo"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_epg_now_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="14:14 - 16:29"
                            android:textColor="#C0D0E8"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Linha 2: Próximo Programa (Ponto Branco) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/bg_epg_row"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:src="@drawable/ic_dot_white"
                            android:alpha="0.8"
                            android:contentDescription="Status" />

                        <TextView
                            android:id="@+id/txt_epg_next_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Próxima Atração"
                            android:textColor="#D0E0F0"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txt_epg_next_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="16:29 - 18:53"
                            android:textColor="#A0B4D0"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Linha 3: Programa Seguinte (Ponto Branco) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_epg_row"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:src="@drawable/ic_dot_white"
                            android:alpha="0.8"
                            android:contentDescription="Status" />

                        <TextView
                            android:id="@+id/txt_epg_third_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Programação da Noite"
                            android:textColor="#D0E0F0"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txt_epg_third_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="18:53 - 20:38"
                            android:textColor="#A0B4D0"
                            android:textSize="11sp" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ============================================================= -->
        <!-- MODO 2: CATÁLOGO VOD FILMES & SÉRIES (FIEL À IMAGEM 1)       -->
        <!-- ============================================================= -->
        <LinearLayout
            android:id="@+id/layout_vod_catalog_mode"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/top_navigation_bar"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <!-- Coluna Esquerda: Botão Procurar + Lista de Categorias de Plataforma -->
            <LinearLayout
                android:layout_width="250dp"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Botão 🔍 Procurar (Topo da Coluna Esquerda como na Imagem 1) -->
                <Button
                    android:id="@+id/btn_vod_search"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_vivaon_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:text="🔍  Procurar"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:nextFocusDown="@+id/rv_category_sidebar"
                    android:nextFocusRight="@+id/rv_vod_grid" />

                <!-- Lista Vertical de Categorias (Filmes/Netflix, Filmes/Disney+, etc.) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_category_sidebar"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:nextFocusUp="@+id/btn_vod_search"
                    android:nextFocusRight="@+id/rv_vod_grid"
                    android:scrollbars="none" />
            </LinearLayout>

            <!-- Área Central/Direita: Botões de Ação + Grade de Posters -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Barra Superior de Ações com Bolinhas Coloridas (Imagem 1) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="8dp">

                    <!-- 🔵 Menu -->
                    <LinearLayout
                        android:id="@+id/btn_vod_action_menu"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_vivaon_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:src="@drawable/ic_dot_blue"
                            android:contentDescription="Menu" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Menu"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 🟡 Ordenar -->
                    <LinearLayout
                        android:id="@+id/btn_vod_action_sort"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_vivaon_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:src="@drawable/ic_dot_yellow"
                            android:contentDescription="Ordenar" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Ordenar"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 🟢 Favoritos -->
                    <LinearLayout
                        android:id="@+id/btn_vod_action_fav"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_vivaon_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:src="@drawable/ic_dot_green"
                            android:contentDescription="Favoritos" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Favoritos"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Contador e Título da Categoria Ativa -->
                    <TextView
                        android:id="@+id/txt_vod_category_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="Filmes/Netflix"
                        android:textColor="#00E5FF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_vod_items_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_netflix_badge"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="Carregando..."
                        android:textColor="#A0B4D0"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Grade de Posters (4 Colunas com OttPosterAdapter) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_vod_grid"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:nextFocusLeft="@+id/rv_category_sidebar"
                    android:scrollbars="none" />
            </LinearLayout>

        </LinearLayout>

        <!-- ============================================================= -->
        <!-- MODO 3: AJUSTES DO SISTEMA                                   -->
        <!-- ============================================================= -->
        <LinearLayout
            android:id="@+id/layout_settings_mode"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/top_navigation_bar"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <!-- Lista de Opções de Configuração -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_settings_list"
                android:layout_width="340dp"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:scrollbars="none" />

            <!-- Painel de Detalhes da Configuração -->
            <LinearLayout
                android:id="@+id/layout_settings_preview"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:background="@drawable/bg_vivaon_pill"
                android:orientation="vertical"
                android:padding="26dp">

                <TextView
                    android:id="@+id/txt_setting_preview_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Configuração"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_setting_preview_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_netflix_badge"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="PADRÃO"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_setting_preview_desc"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="16dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="3dp"
                    android:text="Descrição do ajuste selecionado..."
                    android:textColor="#C0D0E8"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_setting_preview_action"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_button_selector"
                    android:focusable="true"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="Executar Ação (OK)"
                    android:textAllCaps="false"
                    android:textColor="@color/btn_playback_text_selector"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>

    <!-- Elementos Ocultos Mantidos para Compatibilidade de Código -->
    <LinearLayout
        android:id="@+id/layout_main_menu_tabs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <Button android:id="@+id/btn_menu_tv" android:layout_width="0dp" android:layout_height="0dp" />
        <Button android:id="@+id/btn_menu_filmes" android:layout_width="0dp" android:layout_height="0dp" />
        <Button android:id="@+id/btn_menu_series" android:layout_width="0dp" android:layout_height="0dp" />
        <Button android:id="@+id/btn_menu_futebol" android:layout_width="0dp" android:layout_height="0dp" />
        <Button android:id="@+id/btn_menu_infantil" android:layout_width="0dp" android:layout_height="0dp" />
        <Button android:id="@+id/btn_menu_settings" android:layout_width="0dp" android:layout_height="0dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_three_panels"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <LinearLayout android:id="@+id/panel_sidebar" android:layout_width="0dp" android:layout_height="0dp">
            <TextView android:id="@+id/txt_sidebar_section_title" android:layout_width="0dp" android:layout_height="0dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/panel_channels" android:layout_width="0dp" android:layout_height="0dp">
            <TextView android:id="@+id/txt_selected_category_title" android:layout_width="0dp" android:layout_height="0dp" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_vod_list" android:layout_width="0dp" android:layout_height="0dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/layout_vod_preview" android:layout_width="0dp" android:layout_height="0dp">
            <TextView android:id="@+id/txt_vod_preview_title" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/txt_vod_preview_meta" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/txt_vod_preview_plot" android:layout_width="0dp" android:layout_height="0dp" />
            <ImageView android:id="@+id/img_vod_preview_poster" android:layout_width="0dp" android:layout_height="0dp" />
            <Button android:id="@+id/btn_vod_action" android:layout_width="0dp" android:layout_height="0dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/layout_vod_grid_container" android:layout_width="0dp" android:layout_height="0dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_home_lancamentos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <ImageView android:id="@+id/img_hero_backdrop" android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/txt_hero_badge" android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/txt_hero_title" android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/txt_hero_meta" android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/txt_hero_plot" android:layout_width="0dp" android:layout_height="0dp" />
        <Button android:id="@+id/btn_hero_watch" android:layout_width="0dp" android:layout_height="0dp" />
        <Button android:id="@+id/btn_hero_open_menu" android:layout_width="0dp" android:layout_height="0dp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_home_lancamentos" android:layout_width="0dp" android:layout_height="0dp" />
    </LinearLayout>

    <Button android:id="@+id/btn_fullscreen" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

</RelativeLayout>
