<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tv_bg">

    <!-- Camada de Gradiente Escuro Cyberpunk/Futurista -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EB070B12" />

    <!-- 1. Barra Superior Minimalista: Logo WDTECH TV Ã  Esquerda, Status e RelÃ³gio Ã  Direita -->
    <RelativeLayout
        android:id="@+id/top_navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:gravity="center_vertical">

        <!-- Logo WDTECH TV -->
        <LinearLayout
            android:id="@+id/logo_layout"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/logo"
                android:adjustViewBounds="true"
                android:contentDescription="Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="WDTECH"
                android:textColor="@color/text_high"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="TV"
                android:textColor="@color/neon_cyan"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Indicador da Categoria Atual no Topo -->
        <TextView
            android:id="@+id/txt_header_breadcrumb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="24dp"
            android:layout_toEndOf="@id/logo_layout"
            android:text="WDTECH TV â€¢ AO VIVO"
            android:textColor="@color/text_mid"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Status e RelÃ³gio no Topo Direito -->
        <LinearLayout
            android:id="@+id/top_status_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_wifi_tv"
                android:layout_marginEnd="14dp"
                android:contentDescription="WiFi" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_profile_tv"
                android:layout_marginEnd="14dp"
                android:contentDescription="Profile" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:format24Hour="HH:mm"
                android:format12Hour="hh:mm a"
                android:textColor="@color/text_high"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_top_exit"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_button_selector"
                android:drawableStart="@drawable/ic_exit"
                android:drawablePadding="4dp"
                android:focusable="false"
                android:paddingStart="8dp"
                android:paddingEnd="10dp"
                android:text="Sair"
                android:textColor="@color/text_high"
                android:textSize="11sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 2. Corpo em 3 PainÃ©is (Sidebar de Categorias + Grade de Canais + Player ao Vivo) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top_navigation_bar"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <!-- PAINEL 1: MENU LATERAL ESQUERDO (CATEGORIAS) -->
        <LinearLayout
            android:id="@+id/panel_sidebar"
            android:layout_width="210dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingEnd="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:paddingBottom="6dp"
                android:paddingStart="8dp"
                android:text="CATEGORIAS"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_category_sidebar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="false"
                android:nextFocusRight="@id/rv_channel_list"
                android:nextFocusUp="@id/rv_category_sidebar"
                android:scrollbars="none" />
        </LinearLayout>

        <!-- PAINEL 2: CENTRO - LISTA DE CANAIS -->
        <LinearLayout
            android:id="@+id/panel_channels"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="12dp">

            <!-- CabeÃ§alho do Canal com Contador -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="6dp"
                android:paddingStart="8dp">

                <TextView
                    android:id="@+id/txt_selected_category_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Todos os Canais"
                    android:textColor="@color/text_high"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_category_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/badge_hd"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:text="124"
                    android:textColor="@color/neon_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Lista Vertical de Canais -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_channel_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="false"
                android:nextFocusLeft="@id/rv_category_sidebar"
                android:nextFocusRight="@id/player_preview_container"
                android:nextFocusUp="@id/rv_channel_list"
                android:scrollbars="none" />

            <!-- RodapÃ© com InstruÃ§Ã£o -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="8dp"
                android:text="â—€ Categorias  â€¢  OK Tela Cheia  â€¢  â–¶ Player"
                android:textColor="@color/text_low"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- PAINEL 3: DIREITO - PLAYER AO VIVO (PREVIEW) -->
        <RelativeLayout
            android:id="@+id/player_preview_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_player_frame"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusLeft="@id/rv_channel_list">

            <!-- Player de VÃ­deo ExoPlayer -->
            <androidx.media3.ui.PlayerView
                android:id="@+id/player_preview_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:use_controller="false"
                app:resize_mode="fit"
                app:surface_type="texture_view" />

            <!-- Badge Superior Esquerdo [AO VIVO] -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="14dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/badge_live"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="#FF1744" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="AO VIVO"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Spinner de Carregamento -->
            <LinearLayout
                android:id="@+id/preview_loading_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:indeterminateTint="@color/neon_cyan" />

                <TextView
                    android:id="@+id/txt_bitrate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="SINTONIZANDO CANAL..."
                    android:textColor="@color/neon_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Barra Inferior com TÃ­tulo do Canal, Guia EPG e BotÃ£o de Tela Cheia -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:background="#DD05080E"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/btn_fullscreen"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical">

                    <!-- CabeÃ§alho do Canal e ResoluÃ§Ã£o -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txt_preview_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Selecione um canal"
                            android:textColor="@color/text_high"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_preview_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="1080p Full HD • Ao Vivo"
                            android:textColor="@color/neon_cyan"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txt_preview_playback"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/badge_playback"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp"
                            android:paddingTop="1dp"
                            android:paddingBottom="1dp"
                            android:text="⟲ 7 Dias Gravados"
                            android:textColor="@color/neon_cyan"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- EPG: Programa no Ar e HorÃ¡rio -->
                    <LinearLayout
                        android:id="@+id/layout_epg_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/badge_live"
                                android:paddingStart="5dp"
                                android:paddingEnd="5dp"
                                android:paddingTop="1dp"
                                android:paddingBottom="1dp"
                                android:text="NO AR"
                                android:textColor="#FFFFFF"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txt_epg_now_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Carregando guia de programaÃ§Ã£o..."
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txt_epg_now_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="20:30 - 21:45"
                                android:textColor="@color/neon_cyan"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Barra de Progresso do Programa Atual -->
                        <ProgressBar
                            android:id="@+id/pb_epg_progress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_marginTop="4dp"
                            android:max="100"
                            android:progress="45"
                            android:progressDrawable="@drawable/progress_epg" />

                        <!-- Sinopse do Programa Atual -->
                        <TextView
                            android:id="@+id/txt_epg_synopsis"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Sinopse do programa atual..."
                            android:textColor="#8EA2C6"
                            android:textSize="10sp" />

                        <!-- PrÃ³ximo Programa (A Seguir) -->
                        <TextView
                            android:id="@+id/txt_epg_next"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="â–¶ A Seguir: Carregando prÃ³ximo programa..."
                            android:textColor="#5B7398"
                            android:textSize="10sp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- BotÃ£o de Tela Cheia [ â›¶ ] -->
                <ImageButton
                    android:id="@+id/btn_fullscreen"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_button_selector"
                    android:focusable="true"
                    android:src="@drawable/ic_fullscreen"
                    android:contentDescription="Tela Cheia" />
            </RelativeLayout>

        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>

