<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tv_bg">

    <!-- Camada de Gradiente Escuro Cyberpunk/Futurista -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EB070B12" />

    <!-- 1. Barra Superior Minimalista e Futurista: Logo WDTECH TV à Esquerda, Status e Relógio à Direita -->
    <RelativeLayout
        android:id="@+id/top_navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:gravity="center_vertical">

        <!-- Logo WDTECH TV -->
        <LinearLayout
            android:id="@+id/logo_layout"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/logo"
                android:adjustViewBounds="true"
                android:contentDescription="Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="WDTECH"
                android:textColor="@color/text_high"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="TV"
                android:textColor="@color/neon_cyan"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Indicador de Seção / Breadcrumb Minimalista Neon -->
        <TextView
            android:id="@+id/txt_header_breadcrumb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="20dp"
            android:layout_toEndOf="@id/logo_layout"
            android:background="@drawable/badge_live"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="WDTECH TV • SISTEMA PRONTO"
            android:textColor="@color/neon_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Status e Relógio no Topo Direito (Sem Botões Poluídos) -->
        <LinearLayout
            android:id="@+id/top_status_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_wifi_tv"
                android:layout_marginEnd="16dp"
                android:contentDescription="WiFi" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format24Hour="HH:mm"
                android:format12Hour="hh:mm a"
                android:textColor="@color/text_high"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 1.5 BARRA DE MENU PRINCIPAL: TV | FILMES | SERIES | INFANTIL | FUTEBOL -->
    <LinearLayout
        android:id="@+id/layout_main_menu_tabs"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/layout_main_menu_tabs"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginBottom="6dp">

        <Button
            android:id="@+id/btn_menu_tv"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_tab_selector"
            android:text="📺 TV"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:focusable="true"
            android:nextFocusDown="@id/rv_category_sidebar"
            android:nextFocusRight="@id/btn_menu_filmes" />

        <Button
            android:id="@+id/btn_menu_filmes"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_tab_selector"
            android:text="🎬 FILMES"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:focusable="true"
            android:nextFocusLeft="@id/btn_menu_tv"
            android:nextFocusDown="@id/rv_category_sidebar"
            android:nextFocusRight="@id/btn_menu_series" />

        <Button
            android:id="@+id/btn_menu_series"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_tab_selector"
            android:text="🍿 SERIES"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:focusable="true"
            android:nextFocusLeft="@id/btn_menu_filmes"
            android:nextFocusDown="@id/rv_category_sidebar"
            android:nextFocusRight="@id/btn_menu_infantil" />

        <Button
            android:id="@+id/btn_menu_infantil"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_tab_selector"
            android:text="👶 INFANTIL"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:focusable="true"
            android:nextFocusLeft="@id/btn_menu_series"
            android:nextFocusDown="@id/rv_category_sidebar"
            android:nextFocusRight="@id/btn_menu_futebol" />

        <Button
            android:id="@+id/btn_menu_futebol"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_tab_selector"
            android:text="⚽ FUTEBOL"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:focusable="true"
            android:nextFocusLeft="@id/btn_menu_infantil"
            android:nextFocusDown="@id/rv_category_sidebar"
            android:nextFocusRight="@id/btn_menu_settings" />

        <ImageButton
            android:id="@+id/btn_menu_settings"
            android:layout_width="44dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_tab_selector"
            android:src="@drawable/ic_settings"
            android:contentDescription="Ajustes"
            android:focusable="true"
            android:nextFocusLeft="@id/btn_menu_futebol"
            android:nextFocusDown="@id/rv_category_sidebar" />
    </LinearLayout>

    <!-- 2. Corpo em 3 Painéis (Sidebar de Categorias + Grade de Canais + Player ao Vivo) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top_navigation_bar"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <!-- PAINEL 1: MENU LATERAL ESQUERDO (CATEGORIAS - WD STREAM / CYBER TV 2.0) -->
        <LinearLayout
            android:id="@+id/panel_sidebar"
            android:layout_width="220dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingEnd="12dp">

            <!-- Cabeçalho de Categoria Simples e Elegante -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/txt_sidebar_section_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CATEGORIAS • TV"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_category_sidebar"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="false"
                android:nextFocusRight="@id/rv_channel_list"
                android:nextFocusUp="@id/rv_category_sidebar"
                android:scrollbars="none" />


        </LinearLayout>

        <!-- PAINEL 2: CENTRO - LISTA DE CANAIS -->
        <LinearLayout
            android:id="@+id/panel_channels"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="12dp">

            <!-- CabeÃ§alho do Canal com Contador -->
            <LinearLayout
                android:id="@+id/layout_channel_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="false"
                android:paddingTop="2dp"
                android:paddingBottom="6dp"
                android:paddingStart="8dp">

                <TextView
                    android:id="@+id/txt_btn_back_categories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="◄ "
                    android:textColor="@color/neon_cyan"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txt_selected_category_title" 
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Todos os Canais"
                    android:textColor="@color/text_high"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_category_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/badge_hd"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:text="124"
                    android:textColor="@color/neon_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Lista Vertical de Canais -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_channel_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="false"
                android:nextFocusLeft="@id/rv_category_sidebar"
                android:nextFocusRight="@id/player_preview_container"
                android:nextFocusUp="@id/rv_channel_list"
                android:scrollbars="none" />

            <!-- Lista de Filmes / Séries (VOD) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_vod_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="false"
                android:nextFocusLeft="@id/rv_category_sidebar"
                android:nextFocusRight="@id/player_preview_container"
                android:nextFocusUp="@id/rv_vod_list"
                android:scrollbars="none"
                android:visibility="gone" />

            <!-- Lista de Opções de Ajustes (Settings Mode) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_settings_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="false"
                android:nextFocusLeft="@id/rv_category_sidebar"
                android:nextFocusRight="@id/player_preview_container"
                android:nextFocusUp="@id/rv_settings_list"
                android:scrollbars="none"
                android:visibility="gone" />

            <!-- RodapÃ© com InstruÃ§Ã£o -->
            <TextView
                android:id="@+id/txt_channel_footer_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="8dp"
                android:text="&#9668; Categorias  &#8226;  OK Tela Cheia  &#8226;  &#9658; Player"
                android:textColor="@color/text_low"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- PAINEL 3: DIREITO - PLAYER AO VIVO (PREVIEW) -->
        <RelativeLayout
            android:id="@+id/player_preview_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_player_frame"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusLeft="@id/rv_channel_list">

            <!-- Player de VÃ­deo ExoPlayer -->
            <androidx.media3.ui.PlayerView
                android:id="@+id/player_preview_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:use_controller="false"
                app:resize_mode="fit"
                app:surface_type="texture_view" />

            <!-- Badge Superior Esquerdo [AO VIVO] -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="14dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/badge_live"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="#FF1744" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="AO VIVO"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Spinner de Carregamento -->
            <LinearLayout
                android:id="@+id/preview_loading_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:indeterminateTint="@color/neon_cyan" />

                <TextView
                    android:id="@+id/txt_bitrate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="SINTONIZANDO CANAL..."
                    android:textColor="@color/neon_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Barra Inferior OTT / BTV Limpa (Igual à Foto do Usuário) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:background="#E0070B14"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="12dp">

                <!-- Logo Circular do Canal com Borda Neon -->
                <RelativeLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_channel_logo_circle">

                    <ImageView
                        android:id="@+id/img_preview_channel_logo"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_centerInParent="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/logo"
                        android:contentDescription="Logo" />
                </RelativeLayout>

                <!-- Informações e Programação EPG -->
                <LinearLayout
                    android:id="@+id/layout_epg_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Linha 1: Número e Nome do Canal -->
                    <TextView
                        android:id="@+id/txt_preview_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selecione um canal"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Linha 2: "Atual:" em vermelho + Programa atual + "próximo:" em cinza + Próximo + Horário -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Atual: "
                            android:textColor="#FF3B30"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_epg_now_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Transmissão Ao Vivo"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="próximo: "
                            android:textColor="#8899AA"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txt_epg_next"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="A Seguir"
                            android:textColor="#CCD6E0"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txt_epg_now_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="20:00 - 21:30"
                            android:textColor="#00E5FF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Linha 3: Barra de Progresso Horizontal Fina -->
                    <ProgressBar
                        android:id="@+id/pb_epg_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="5dp"
                        android:max="100"
                        android:progress="45"
                        android:progressDrawable="@drawable/progress_epg" />
                </LinearLayout>

                <!-- Elementos ocultos para manter compatibilidade com MainActivity.kt -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone">

                    <TextView android:id="@+id/txt_preview_info" android:layout_width="0dp" android:layout_height="0dp" />
                    <TextView android:id="@+id/txt_preview_playback" android:layout_width="0dp" android:layout_height="0dp" />
                    <TextView android:id="@+id/txt_epg_synopsis" android:layout_width="0dp" android:layout_height="0dp" />
                    <ImageButton android:id="@+id/btn_fullscreen" android:layout_width="0dp" android:layout_height="0dp" />
                </LinearLayout>
            </LinearLayout><!-- Painel de Detalhes do Filme / Série (VOD Mode) -->
            <LinearLayout
                android:id="@+id/layout_vod_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#E8070B14"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <!-- Pôster Grande do Filme / Série -->
                    <ImageView
                        android:id="@+id/img_vod_preview_poster"
                        android:layout_width="155dp"
                        android:layout_height="match_parent"
                        android:background="#151E2D"
                        android:scaleType="centerCrop"
                        android:contentDescription="Poster" />

                    <!-- Informações: Título, Metadados e Sinopse -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txt_vod_preview_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Título do Filme / Série"
                            android:textColor="@color/text_white"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_vod_preview_meta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="⭐ 8.5 • 2025 • Lançamento • FHD"
                            android:textColor="@color/neon_cyan"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_vod_preview_plot"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="12dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="8"
                            android:lineSpacingExtra="3dp"
                            android:text="Carregando sinopse..."
                            android:textColor="#C0D1EC"
                            android:textSize="12sp" />

                        <!-- Botão de Ação Primário do VOD -->
                        <Button
                            android:id="@+id/btn_vod_action"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_button_selector"
                            android:focusable="true"
                            android:paddingStart="24dp"
                            android:paddingEnd="24dp"
                            android:text="▶ Assistir Filme (OK)"
                            android:textAllCaps="false"
                            android:textColor="@color/btn_playback_text_selector"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Painel de Detalhes dos Ajustes / Configurações (Settings Mode) -->
            <LinearLayout
                android:id="@+id/layout_settings_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#E8070B14"
                android:orientation="vertical"
                android:padding="26dp"
                android:visibility="gone">

                <!-- Cabeçalho do Card de Ajuste -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/img_setting_preview_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/badge_hd"
                        android:padding="10dp"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/neon_cyan"
                        android:contentDescription="Setting Icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txt_setting_preview_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ajustes do Aplicativo"
                            android:textColor="@color/text_white"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_setting_preview_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:background="@drawable/badge_live"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="CONFIGURAÇÃO ATIVA"
                            android:textColor="@color/neon_cyan"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Divisor Ciano Sutil -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:background="#2000E5FF" />

                <!-- Descrição Completa e Detalhes da Opção -->
                <TextView
                    android:id="@+id/txt_setting_preview_desc"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="4dp"
                    android:text="Selecione um ajuste à esquerda para gerenciar configurações avançadas, reprodução e sistema."
                    android:textColor="#C0D1EC"
                    android:textSize="14sp" />

                <!-- Botão de Ação Interativo (D-Pad navegável) -->
                <Button
                    android:id="@+id/btn_setting_preview_action"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_button_selector"
                    android:focusable="true"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="Executar Ação (OK)"
                    android:textAllCaps="false"
                    android:textColor="@color/btn_playback_text_selector"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>

