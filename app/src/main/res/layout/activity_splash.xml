<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_dark">

    <!-- 1. Aura de Fundo Pulsante / Luz Volumétrica Ambiente -->
    <View
        android:id="@+id/view_splash_aura"
        android:layout_width="450dp"
        android:layout_height="450dp"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_logo_aura" />

    <!-- 2. Conteúdo Central: Logotipo em Camadas, Tipografia e Status -->
    <LinearLayout
        android:id="@+id/splash_center_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Container do Emblema Futurista com Halo e Efeito de Shimmer -->
        <FrameLayout
            android:id="@+id/layout_logo_container"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center_horizontal">

            <!-- Anel Orbital / Halo Neon de Expansão Contínua -->
            <View
                android:id="@+id/view_splash_halo"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_logo_halo" />

            <!-- Novo Logotipo Emblemático WDTECH TV (Vetor 3D Hexagonal) -->
            <ImageView
                android:id="@+id/img_splash_logo"
                android:layout_width="144dp"
                android:layout_height="144dp"
                android:layout_gravity="center"
                android:contentDescription="Logotipo Oficial WDTECH TV"
                android:src="@drawable/ic_wdtech_logo_vector" />

            <!-- Feixe de Luz / Shimmer Sweep Transversal -->
            <View
                android:id="@+id/view_splash_shimmer"
                android:layout_width="50dp"
                android:layout_height="144dp"
                android:layout_gravity="center"
                android:background="@drawable/light_sweep_beam"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Tipografia Cinética de Identidade da Marca -->
        <LinearLayout
            android:id="@+id/layout_brand_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_brand_wdtech"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="WDTECH"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_brand_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/badge_hd"
                android:letterSpacing="0.08"
                android:paddingStart="12dp"
                android:paddingTop="3dp"
                android:paddingEnd="12dp"
                android:paddingBottom="3dp"
                android:text="TV"
                android:textColor="@color/neon_cyan"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Subtítulo de Posicionamento Tecnológico -->
        <TextView
            android:id="@+id/txt_brand_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.20"
            android:text="SISTEMA DE ENTRETENIMENTO INTELIGENTE"
            android:textColor="#7A93B2"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Badge Dinâmico da Versão -->
        <TextView
            android:id="@+id/txt_splash_version_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/badge_live"
            android:backgroundTint="#2600E5FF"
            android:letterSpacing="0.14"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp"
            android:text="VERSÃO 2.7.2"
            android:textColor="@color/neon_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Barra de Progresso Fluida Neon -->
        <ProgressBar
            android:id="@+id/splash_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="280dp"
            android:layout_height="4dp"
            android:layout_marginTop="26dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_splash_neon" />

        <!-- Feedback de Inicialização e Status em Tempo Real -->
        <TextView
            android:id="@+id/txt_splash_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.06"
            android:text="Iniciando sistema..."
            android:textColor="@color/neon_cyan"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Rodapé Futurista Fixo -->
    <TextView
        android:id="@+id/txt_splash_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"
        android:letterSpacing="0.08"
        android:text="WDTECH TV • 4K Ultra HD • Guia EPG Integrado • Leanback Edition"
        android:textColor="#526A87"
        android:textSize="12sp" />

</RelativeLayout>
