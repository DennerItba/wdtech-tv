<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="142dp"
    android:layout_height="212dp"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:clickable="true"
    android:focusable="true"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- Poster da Mídia com Cantos Arredondados -->
    <ImageView
        android:id="@+id/img_poster_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="#151E2D"
        android:src="@drawable/logo"
        android:contentDescription="Poster" />

    <!-- Camada de Gradiente Escuro Inferior -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_poster_scrim" />

    <!-- Micro-Badge Estilo Netflix no Topo Esquerdo (Discreto) -->
    <TextView
        android:id="@+id/txt_poster_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="6dp"
        android:background="@drawable/bg_netflix_badge"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="4K"
        android:textColor="#00E5FF"
        android:textSize="9sp"
        android:textStyle="bold" />

    <!-- Micro-Badge Nota / IMDb no Topo Direito (Discreto) -->
    <TextView
        android:id="@+id/txt_poster_rating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/bg_netflix_badge"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="⭐ 8.5"
        android:textColor="#FFD700"
        android:textSize="9sp"
        android:textStyle="bold" />

    <!-- Título do Filme / Série na Base -->
    <TextView
        android:id="@+id/txt_poster_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:shadowColor="#EE000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:text="Filme / Série"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Borda e Destaque de Foco D-Pad Neon -->
    <View
        android:id="@+id/view_poster_focus_ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_netflix_card_focus"
        android:visibility="gone" />

</FrameLayout>
