<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Player de Vídeo em Tela Cheia -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:surface_type="texture_view"
        app:resize_mode="fit" />

    <!-- Indicador de Carregamento Central com Bitrate (Estilo OTT BTV) -->
    <LinearLayout
        android:id="@+id/player_buffering_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/player_buffering"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminateTint="@color/brand_red"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txt_player_buffering_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="26KB/S"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Card de Erro e Reconexão Futurista -->
    <LinearLayout
        android:id="@+id/player_error_layout"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_card_selector"
        android:backgroundTint="#F20B101D"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center"
        android:elevation="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/txt_player_error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Sinal Temporariamente Instável"
            android:textColor="@color/btn_text_selector"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_player_error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Ocorreu uma instabilidade na transmissão deste canal. O sistema WDTECH TV tentará restabelecer a conexão."
            android:textColor="#9DB2D8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txt_player_error_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tentando reconectar automaticamente em 3s..."
            android:textColor="@color/neon_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_player_error_retry"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_button_selector"
                android:text="🔄 Tentar Novamente"
                android:textColor="@color/btn_text_selector"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:focusable="true" />

            <Button
                android:id="@+id/btn_player_error_back"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_button_selector"
                android:text="Voltar à Grade"
                android:textColor="@color/btn_text_selector"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- OSD Overlay: HUD Moderno OTT / BTV Sem Poluição de Botões -->
    <RelativeLayout
        android:id="@+id/player_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <!-- Relógio no Topo Direito (Limpo e Elegante) -->
        <TextClock
            android:id="@+id/tc_player_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="36dp"
            android:format24Hour="HH:mm"
            android:format12Hour="hh:mm a"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Rodapé Moderno OTT / BTV (Exato como na Foto do Usuário) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@drawable/gradient_bottom"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:paddingTop="26dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Logo Circular do Canal com Borda Cyan -->
                <RelativeLayout
                    android:id="@+id/layout_player_logo_container"
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_channel_logo_circle">

                    <ImageView
                        android:id="@+id/img_player_channel_logo"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_centerInParent="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/logo"
                        android:contentDescription="Canal Logo" />
                </RelativeLayout>

                <!-- Informações do Canal e Programação EPG -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Linha 1: Número do Canal em Cyan e Nome do Canal em Branco -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txt_player_channel_number"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4"
                            android:textColor="#00E5FF"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_player_channel_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="A FAZENDA 18 SINAL 4"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Linha 2: "Atual:" em vermelho + Programa atual + "próximo:" em cinza + Próximo programa + Horário -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txt_player_label_atual"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Atual: "
                            android:textColor="#FF3B30"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_player_epg_now_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Transmissão Ao Vivo"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/txt_player_label_proximo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="próximo: "
                            android:textColor="#8899AA"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txt_player_epg_next"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="A Seguir"
                            android:textColor="#CCD6E0"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txt_player_epg_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="20:00 - 21:30"
                            android:textColor="#00E5FF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Linha 3: Barra de Progresso Horizontal Fina Neon -->
                    <ProgressBar
                        android:id="@+id/pb_player_epg"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progress="45"
                        android:progressDrawable="@drawable/progress_epg" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Elementos Ocultos para total compatibilidade com lógica existente (Sem Poluição de Botões) -->
        <LinearLayout
            android:id="@+id/layout_player_playback_controls"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">

            <Button android:id="@+id/btn_player_back" android:layout_width="0dp" android:layout_height="0dp" />
            <Button android:id="@+id/btn_player_aspect_ratio" android:layout_width="0dp" android:layout_height="0dp" />
            <Button android:id="@+id/btn_player_settings" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/txt_player_channel_category" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/txt_player_badge_mode" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/txt_player_playback_badge" android:layout_width="0dp" android:layout_height="0dp" />
            <Button android:id="@+id/btn_player_rewind" android:layout_width="0dp" android:layout_height="0dp" />
            <Button android:id="@+id/btn_player_forward" android:layout_width="0dp" android:layout_height="0dp" />
            <Button android:id="@+id/btn_player_restart" android:layout_width="0dp" android:layout_height="0dp" />
            <Button android:id="@+id/btn_player_live" android:layout_width="0dp" android:layout_height="0dp" />
            <Button android:id="@+id/btn_player_history" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/txt_player_playback_status" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/txt_player_epg_synopsis" android:layout_width="0dp" android:layout_height="0dp" />
        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>
