<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Player de Vídeo em Tela Cheia -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:surface_type="texture_view"
        app:resize_mode="fit" />

    <!-- Indicador de Carregamento Central -->
    <ProgressBar
        android:id="@+id/player_buffering"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_centerInParent="true"
        android:indeterminateTint="@color/brand_red"
        android:visibility="gone" />

    <!-- Card de Erro e Reconexão Futurista (Cyberpunk TV) -->
    <LinearLayout
        android:id="@+id/player_error_layout"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_card_selector"
        android:backgroundTint="#F20B101D"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center"
        android:elevation="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/txt_player_error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Sinal Temporariamente Instável"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_player_error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Ocorreu uma instabilidade na transmissão deste canal. O sistema WDTECH TV tentará restabelecer a conexão."
            android:textColor="#9DB2D8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txt_player_error_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tentando reconectar automaticamente em 3s..."
            android:textColor="@color/neon_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_player_error_retry"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_button_selector"
                android:text="🔄 Tentar Novamente"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:focusable="true" />

            <Button
                android:id="@+id/btn_player_error_back"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_button_selector"
                android:text="Voltar à Grade"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- OSD Overlay (Controles e Informações na Tela) -->
    <RelativeLayout
        android:id="@+id/player_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <!-- Barra Superior com Botão de Voltar / Sair e Info do Canal -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="@drawable/gradient_bottom"
            android:rotation="180"
            android:padding="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="30dp"
            android:paddingEnd="30dp">

            <!-- Botão Voltar / Sair do Player -->
            <Button
                android:id="@+id/btn_player_back"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_button_selector"
                android:drawableStart="@drawable/ic_back"
                android:drawablePadding="8dp"
                android:focusable="true"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:text="Voltar à Grade"
                android:textAllCaps="false"
                android:textColor="@color/text_white"
                android:textSize="14sp" />

            <!-- Nome do Canal Atual -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_player_channel_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nome do Canal"
                    android:textColor="@color/text_white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_player_channel_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TV Ao Vivo • Alta Definição"
                    android:textColor="@color/text_gray"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format24Hour="HH:mm"
                android:format12Hour="hh:mm a"
                android:textColor="@color/text_white"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Barra Inferior com Guia EPG Completo (No Ar & A Seguir) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@drawable/gradient_bottom"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_live"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="AO VIVO"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_player_epg_now_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Programa Atual"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_player_epg_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="20:30 - 21:45"
                    android:textColor="@color/neon_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Barra de Progresso EPG -->
            <ProgressBar
                android:id="@+id/pb_player_epg"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="50"
                android:progressDrawable="@drawable/progress_epg" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txt_player_epg_synopsis"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Sinopse do programa..."
                    android:textColor="#8EA2C6"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/txt_player_epg_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="▶ A Seguir: Próximo Programa"
                    android:textColor="#607D8B"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>
