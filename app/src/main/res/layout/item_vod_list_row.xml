<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/bg_channel_item_selector"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <!-- Capa / Poster Vertical do Filme ou Série -->
    <ImageView
        android:id="@+id/img_vod_poster"
        android:layout_width="38dp"
        android:layout_height="52dp"
        android:scaleType="centerCrop"
        android:background="#1B2838"
        android:contentDescription="Poster" />

    <!-- Textos: Título, Nota e Gênero/Ano -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Título do Filme / Série -->
        <TextView
            android:id="@+id/txt_vod_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Título do Filme"
            android:textColor="@color/text_high"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Subtítulo: Nota + Gênero / Ano -->
        <TextView
            android:id="@+id/txt_vod_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="⭐ 8.2 • Lançamento"
            android:textColor="#8EA2C6"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Badge HD / FHD / 4K / SÉRIE -->
    <TextView
        android:id="@+id/txt_vod_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/badge_hd"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="FHD"
        android:textColor="#9AB2D6"
        android:textSize="9sp"
        android:textStyle="bold" />

</LinearLayout>
