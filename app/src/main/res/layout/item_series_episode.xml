<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/bg_channel_item_selector"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <!-- Ícone Play -->
    <TextView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="@drawable/badge_playback"
        android:gravity="center"
        android:text="▶"
        android:textColor="@color/neon_cyan"
        android:textSize="10sp"
        android:textStyle="bold" />

    <!-- Nome do Episódio -->
    <TextView
        android:id="@+id/txt_ep_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="S01E01 - Episódio 1"
        android:textColor="@color/text_white"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Duração ou Qualidade -->
    <TextView
        android:id="@+id/txt_ep_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/badge_hd"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="FHD"
        android:textColor="#9AB2D6"
        android:textSize="10sp" />

</LinearLayout>
