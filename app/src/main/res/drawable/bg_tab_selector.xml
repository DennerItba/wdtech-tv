<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focado pelo controle remoto -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#00E5FF" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- Aba Selecionada / Ativa -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#3300E5FF" />
            <stroke android:width="2dp" android:color="#00E5FF" />
        </shape>
    </item>

    <!-- Pressionado -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#00E5FF" />
        </shape>
    </item>

    <!-- Padrão Inativo -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#141C2B" />
            <stroke android:width="1dp" android:color="#24334A" />
        </shape>
    </item>
</selector>
