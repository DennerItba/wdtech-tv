        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#222B3D" />
            <stroke android:width="3dp" android:color="#E50914" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#141923" />
            <stroke android:width="1dp" android:color="#2A354C" />
        </shape>
    </item>
</selector>
