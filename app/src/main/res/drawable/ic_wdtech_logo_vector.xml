<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- 1. Brilho do Contorno Hexagonal Externo -->
    <path
        android:strokeWidth="2.5"
        android:pathData="M100,10 L180,55 L180,145 L100,190 L20,145 L20,55 Z">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="20"
                android:startY="10"
                android:endX="180"
                android:endY="190"
                android:type="linear">
                <item android:offset="0.0" android:color="#00E5FF" />
                <item android:offset="0.5" android:color="#0077FE" />
                <item android:offset="1.0" android:color="#7B1FA2" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. Fundo Escuro Translúcido Interno -->
    <path
        android:pathData="M100,16 L174,58 L174,142 L100,184 L26,142 L26,58 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="100"
                android:startY="16"
                android:endX="100"
                android:endY="184"
                android:type="linear">
                <item android:offset="0.0" android:color="#E60D1B2A" />
                <item android:offset="1.0" android:color="#F2050811" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. Monograma Estilizado "W" e "D" em Linhas Tecnológicas -->
    <!-- Letra W (Lado Esquerdo e Central) -->
    <path
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M48,65 L64,135 L84,92 L100,135 L116,92">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="48"
                android:startY="65"
                android:endX="116"
                android:endY="135"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="0.6" android:color="#00E5FF" />
                <item android:offset="1.0" android:color="#0052D4" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Letra D (Curva Futurista Externa) -->
    <path
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M100,65 L126,65 C146,65 158,80 158,100 C158,120 146,135 126,135 L108,135">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="100"
                android:startY="65"
                android:endX="158"
                android:endY="135"
                android:type="linear">
                <item android:offset="0.0" android:color="#00E5FF" />
                <item android:offset="1.0" android:color="#0052D4" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 4. Play Triangle Neon Central (Símbolo de Transmissão de Vídeo / TV) -->
    <path
        android:pathData="M94,86 L118,100 L94,114 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="94"
                android:startY="86"
                android:endX="118"
                android:endY="114"
                android:type="linear">
                <item android:offset="0.0" android:color="#00E5FF" />
                <item android:offset="1.0" android:color="#FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 5. Pontos de Destaque Tecnológico (Glow Accents) -->
    <path
        android:fillColor="#00E5FF"
        android:pathData="M100,26 A3,3 0 1,1 99.9,26 Z" />
    <path
        android:fillColor="#00E5FF"
        android:pathData="M165,63 A3,3 0 1,1 164.9,63 Z" />
    <path
        android:fillColor="#0077FE"
        android:pathData="M165,137 A3,3 0 1,1 164.9,137 Z" />
    <path
        android:fillColor="#7B1FA2"
        android:pathData="M100,174 A3,3 0 1,1 99.9,174 Z" />
    <path
        android:fillColor="#00E5FF"
        android:pathData="M35,63 A3,3 0 1,1 34.9,63 Z" />

</vector>
