<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado FOCADO (Controle remoto sobre o botão) - Fundo Azul Marinho Profundo com Borda Neon Ciano: Alto Contraste e Letras 100% Legíveis -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#1A3B6B" />
            <stroke android:width="2.5dp" android:color="#00E5FF" />
        </shape>
    </item>

    <!-- Estado PRESSIONADO / CLICADO -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#244F8E" />
            <stroke android:width="2.5dp" android:color="#00E5FF" />
        </shape>
    </item>

    <!-- Estado PADRÃO (Inativo) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#182234" />
            <stroke android:width="1.2dp" android:color="#2C3C56" />
        </shape>
    </item>
</selector>
