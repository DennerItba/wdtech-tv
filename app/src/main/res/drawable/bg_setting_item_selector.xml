<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado Focado pelo Controle Remoto (Glow Neon Cyan Futurista) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2A3D5E" />
            <stroke android:width="2dp" android:color="#00E5FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Estado Selecionado -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#20304A" />
            <stroke android:width="1.5dp" android:color="#4000E5FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Estado Padrão -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#131B28" />
            <stroke android:width="1dp" android:color="#1D2A3D" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
