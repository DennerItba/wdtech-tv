<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="135"
                android:startColor="#255D9E"
                android:endColor="#153256"
                android:type="linear" />
            <stroke android:width="3dp" android:color="@color/wd_focus_glow" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="135"
                android:startColor="@color/wd_tile_mid_1"
                android:endColor="@color/wd_tile_mid_2"
                android:type="linear" />
            <stroke android:width="1dp" android:color="@color/wd_tile_stroke" />
        </shape>
    </item>
</selector>
