<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado FOCADO (Cursor do controle sobre a categoria) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#2A3F66" />
            <stroke android:width="2.5dp" android:color="@color/neon_cyan" />
        </shape>
    </item>
    <!-- Estado SELECIONADO (Categoria ativa na lista de canais) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#18253B" />
            <stroke android:width="1.5dp" android:color="@color/neon_cyan" />
        </shape>
    </item>
    <!-- Estado PADRÃO -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
