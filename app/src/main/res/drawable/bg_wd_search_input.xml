<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#1F324E" />
            <stroke android:width="2dp" android:color="@color/wd_focus_glow" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/wd_search_bg" />
            <stroke android:width="1dp" android:color="@color/wd_search_stroke" />
        </shape>
    </item>
</selector>
