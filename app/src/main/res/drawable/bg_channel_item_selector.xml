<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado FOCADO (Cursor do controle remoto ativo no canal) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#243C6E" />
            <stroke android:width="3dp" android:color="@color/neon_cyan" />
        </shape>
    </item>
    <!-- Estado SELECIONADO (Canal ativo em reprodução) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#1A273D" />
            <stroke android:width="1.5dp" android:color="@color/neon_cyan" />
        </shape>
    </item>
    <!-- Estado PADRÃO -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#101726" />
            <stroke android:width="1dp" android:color="#1A263B" />
        </shape>
    </item>
</selector>
